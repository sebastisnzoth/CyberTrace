{
  "name": "CyberTrace Codespace",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "CyberTrace Flask",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt",
  "postStartCommand": "nohup python app.py > /tmp/cybertrace.log 2>&1 &",
  "remoteUser": "vscode"
}
